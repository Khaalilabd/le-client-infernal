# Copier ce fichier en server/.env (fait automatiquement par `npm run setup`).
# Ne jamais committer le fichier .env.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Base locale lancée par docker-compose (port 5434)
DATABASE_URL=postgresql://infernal:infernal@localhost:5434/client_infernal?schema=public

# Authentification
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------
# Service IA
# AI_PROVIDER : auto | mock | claude | openai | ollama
#   auto -> claude si ANTHROPIC_API_KEY, sinon openai si OPENAI_API_KEY, sinon mock
# ---------------------------------------------------------------
AI_PROVIDER=auto
# Modèle (facultatif, sinon valeur par défaut du fournisseur)
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Embeddings (vectorisation pour le RAG) : auto | none | openai | ollama
#   auto -> ollama si AI_PROVIDER vaut ollama, sinon openai si OPENAI_API_KEY, sinon none
#   none -> les modules utilisent leur vectorisation locale (TF-IDF), sans appel réseau
AI_EMBEDDING_PROVIDER=auto
# Modèle d'embeddings (facultatif) : text-embedding-3-small (openai), nomic-embed-text (ollama)
#   avec Gemini (OPENAI_BASE_URL ci-dessous) : gemini-embedding-001 (testé en P-016, seuils du RAG calibrés) ;
#   si le modèle est refusé, le module 1 utilise sa vectorisation locale (« RAG : embeddings indisponibles »)
AI_EMBEDDING_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Facultatif : API compatible OpenAI (laisser vide pour OpenAI). Exemple Gemini (clé gratuite Google AI Studio) :
#   AI_PROVIDER=openai, OPENAI_API_KEY=<clé Gemini>, AI_MODEL=gemini-flash-lite-latest, AI_TIMEOUT_MS=60000
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   (configuration testée sur tout le parcours en P-016 ; les modèles plus lourds dépassent souvent le délai)
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
