# Copier ce fichier en server/.env (fait automatiquement par `npm run setup`).
# Ne jamais committer le fichier .env.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Base locale lancée par docker-compose (port 5434)
DATABASE_URL=postgresql://infernal:infernal@localhost:5434/client_infernal?schema=public

# Authentification
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------
# Service IA
# AI_PROVIDER : auto | mock | claude | openai | ollama
#   auto -> claude si ANTHROPIC_API_KEY, sinon openai si OPENAI_API_KEY, sinon mock
# ---------------------------------------------------------------
AI_PROVIDER=auto
# Modèle (facultatif, sinon valeur par défaut du fournisseur)
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Embeddings (vectorisation pour le RAG) : auto | none | openai | ollama
#   auto -> ollama si AI_PROVIDER vaut ollama, sinon openai si OPENAI_API_KEY, sinon none
#   none -> les modules utilisent leur vectorisation locale (TF-IDF), sans appel réseau
AI_EMBEDDING_PROVIDER=auto
# Modèle d'embeddings (facultatif) : text-embedding-3-small (openai), nomic-embed-text (ollama)
AI_EMBEDDING_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
